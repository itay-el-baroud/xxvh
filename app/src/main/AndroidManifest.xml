<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- أذونات قراءة سجل المكالمات والرسائل (ضرورية لحظرها) -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    
    <!-- إذن عرض الإشعارات على أندرويد 13 والإصدارات الأحدث -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- إذن قراءة حالة الهاتف (لتحديد رقم المتصل) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    
    <!-- إذن بدء التطبيق تلقائياً عند إعادة تشغيل الهاتف (لضمان استمرار الحظر) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallShield"
        android:name=".CallShieldApp">

        <!-- النشاط الرئيسي (الشاشة الأولى عند فتح التطبيق) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CallShield">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- مستقبل البث (لتشغيل التطبيق عند إعادة تشغيل الهاتف) -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        
    </application>

</manifest>
